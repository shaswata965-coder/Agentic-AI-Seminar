# Copy to .env.local for development (or set these in the server environment).
# Never commit real secrets. Variables starting with NEXT_PUBLIC_ are built into
# the site at `npm run build` time — rebuild after changing them.

# --- Database (required) -------------------------------------------------------
# Local MongoDB, a MongoDB Atlas cluster, or the `mongo` service in docker-compose.
MONGODB_URI=mongodb://127.0.0.1:27017/aaiw
# Optional: database name if it is not part of the URI.
# MONGODB_DB=aaiw

# --- Public address --------------------------------------------------------------
# Full public origin, used for links in e-mails, calendar files, the sitemap and
# social previews. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set when the site lives under a path, e.g. https://scai.iitd.ac.in/agentic-ai-workshop
# NEXT_PUBLIC_BASE_PATH=/agentic-ai-workshop

# --- Admin panel (/admin) ----------------------------------------------------------
# Signs the admin session cookie. Required in production: 32+ random characters,
# e.g. `openssl rand -base64 48`.
AUTH_SECRET=
# First administrator: on an empty database, signing in with these creates the
# account. Change the password under "My account" afterwards.
# (Alternatively run `npm run create-admin -- --email you@iitd.ac.in`.)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# The session cookie is HTTPS-only in production. Set to false ONLY to test a
# production build over plain HTTP (not needed on localhost).
# COOKIE_SECURE=false

# --- E-mail (optional) -----------------------------------------------------------
# Without SMTP, registrations and enquiries are still saved but no e-mails are sent.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false        # true for port 465
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Agentic AI Workshop 2026 <no-reply@example.com>"
# Where organiser notifications go (can also be set in Admin → Site settings → Contact).
# NOTIFY_EMAIL=organisers@example.com

# --- Analytics (optional) --------------------------------------------------------
# Google Analytics 4 measurement ID. Can also be set in Admin → Site settings → SEO.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# --- Uploads (optional) ------------------------------------------------------------
# Maximum size of one upload in the media library, in MB (default 8).
# MAX_UPLOAD_MB=8
