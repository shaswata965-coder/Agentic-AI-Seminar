# The reverse proxy as README.md now sets it up ("Reverse proxy with HTTPS (Nginx)"): its upstream, cache,
# maps and server block, word for word but for the load test's paths, ports and host name, plus a log
# line per request for tools/report.mjs. Keep the two in step. up.sh fills in the @...@ values.
#   - 4,096 connections per worker, and kept-alive connections to Next.js;
#   - build files (/_next/static, content-hashed) fetched from Next.js once and kept;
#   - pages, router prefetches and public files cached for 2 seconds, one gzipped and one plain copy each,
#     so a rush reaches Next.js about once per page every 2 seconds. Signed-in organisers and the admin's
#     live preview (Draft Mode) bypass it; /api/ and /admin are never cached.

worker_processes @WORKERS@;
pid @RUN@/nginx.pid;
error_log @RUN@/logs/nginx-error.log warn;
worker_rlimit_nofile 65535;

events {
    worker_connections 4096;
}

http {
    # Ubuntu's stock nginx.conf.
    sendfile on;
    tcp_nopush on;
    types_hash_max_size 2048;
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    gzip on;

    client_body_temp_path @RUN@/tmp/body;
    proxy_temp_path @RUN@/tmp/proxy;
    fastcgi_temp_path @RUN@/tmp/fastcgi;
    uwsgi_temp_path @RUN@/tmp/uwsgi;
    scgi_temp_path @RUN@/tmp/scgi;

    log_format loadtest '$remote_addr $status $request_method "$uri" $request_time $upstream_response_time $body_bytes_sent $upstream_cache_status';
    access_log @RUN@/logs/nginx-access.log loadtest buffer=256k flush=2s;

    # ---- From README.md ------------------------------------------------------------------------------
    upstream aaiw {
        server 127.0.0.1:@APP_PORT@;
        keepalive 64;
    }
    proxy_cache_path @RUN@/cache levels=1:2 keys_zone=aaiw:10m max_size=512m inactive=7d use_temp_path=off;
    map "$cookie_aaiw_admin$cookie___prerender_bypass" $aaiw_no_cache { default 1; "" 0; }
    map $http_accept_encoding $aaiw_encoding { ~*gzip gzip; default ""; }

    server {
        listen 443 ssl http2;
        server_name localhost;
        ssl_certificate     @RUN@/tls/cert.pem;
        ssl_certificate_key @RUN@/tls/key.pem;
        client_max_body_size 10m;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;

        location /api/  { proxy_pass http://aaiw; }
        location /admin { proxy_pass http://aaiw; }

        location /_next/static/ {
            proxy_pass http://aaiw;
            proxy_set_header Accept-Encoding $aaiw_encoding;
            proxy_cache aaiw;
            proxy_cache_key "$host$request_uri|$aaiw_encoding";
            proxy_cache_valid 200 30d;
            proxy_ignore_headers Vary;
        }

        location / {
            proxy_pass http://aaiw;
            proxy_set_header Accept-Encoding $aaiw_encoding;
            proxy_cache aaiw;
            proxy_cache_key "$host$request_uri|$aaiw_encoding|$http_rsc|$http_next_router_prefetch|$http_next_router_segment_prefetch|$http_next_router_state_tree|$http_next_url";
            proxy_cache_valid 200 301 302 307 308 404 2s;
            proxy_ignore_headers Cache-Control Expires Vary;
            proxy_cache_lock on;
            proxy_cache_use_stale updating error timeout http_500 http_502 http_503 http_504;
            proxy_cache_background_update on;
            proxy_cache_bypass $aaiw_no_cache;
            proxy_no_cache $aaiw_no_cache;
        }
    }
    server { listen 80; server_name localhost; return 301 https://$host$request_uri; }
}
